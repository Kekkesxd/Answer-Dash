{
  "name": "answer-dash",
  "version": "1.0.0",
  "description": "A fast-paced neon arcade trivia game where you physically move your player to the correct answer zone before the timer runs out.",
  "homepage": "https://github.com/Kekkesxd/Answer-Dash#readme",
  "bugs": {
    "url": "https://github.com/Kekkesxd/Answer-Dash/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kekkesxd/Answer-Dash.git"
  },
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "format": "prettier ./src/ --write && prettier ./server/ --write",
    "formatCheck": "prettier ./src/ --check && prettier ./server/ --check",
    "lint": "eslint src && eslint server",
    "test": "jest",
    "dev": "nodemon server/server.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jest": "^30.4.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.29.5",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.8.3"
  },
  "prettier": {
    "trailingComma": "es5",
    "tabWidth": 2,
    "semi": true
  },
  "babel": {
    "presets": [
      [
        "@babel/preset-env",
        {
          "targets": {
            "node": "current"
          }
        }
      ]
    ]
  }
}
